{
  "name": "walk-dont-run",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "firebase": "^12.13.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "victory-native": "^36.9.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "automock": false,
    "collectCoverageFrom": [
      "services/**/*.ts",
      "utils/**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    },
    "moduleNameMapper": {
      "^firebase/firestore$": "<rootDir>/__mocks__/firebase/firestore.js"
    }
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.3": true
  }
}
